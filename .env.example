# Discord
DISCORD_TOKEN=replace-me
DISCORD_APPLICATION_ID=replace-me
# Set this during development for immediate slash-command updates.
DISCORD_GUILD_ID=replace-me
# One common notification channel. A realm-specific notificationChannelId in REALMS_JSON wins.
DISCORD_NOTIFY_CHANNEL_ID=replace-me
# Set true only after enabling Message Content Intent in the Discord Developer Portal.
DISCORD_MESSAGE_CONTENT_INTENT=false

# Microsoft/Xbox / Bedrock
# This is only a cache key, not an email address or password.
AUTH_CACHE_KEY=bedrock-realms-bot
BEDROCK_VERSION=1.26.40
# Native RakNet is recommended for current Bedrock Realms. Use jsp-raknet only as a fallback.
RAKNET_BACKEND=raknet-native

# Realm list. The account must be a member or owner of each Realm.
REALMS_JSON=[{"id":"1234567890","name":"My Realm"}]

# Persistence
DATA_DIR=./data

# Polling and reconnects
PRESENCE_POLL_MS=60000
STORY_POLL_MS=60000
RECONNECT_BASE_MS=10000

# protocol (default): reliable player list from a persistent Realm session;
# api: use /activities/live/players without joining as a visible player.
PRESENCE_SOURCE=protocol

# Story Feed / Timeline event endpoints are not part of the stable public Realms API.
# Leave blank unless you have confirmed an endpoint for your client/service version.
# The response may be an array or an object containing events/stories/items/data.
REALM_STORY_EVENTS_PATH_TEMPLATE=
